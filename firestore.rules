rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notifications/{date}/games/{gamePk} {
      // Only Cloud Functions can read/write (using Admin SDK).
      // No client access — the browser never touches Firestore directly.
      allow read, write: if false;
    }

    match /watchability/{document} {
      // Written by buildWatchability, read by the notify-* functions and
      // liveScores. The browser reads this data through the
      // watchabilityPayload HTTP function, never directly.
      allow read, write: if false;
    }
  }
}
